{
  "name": "designstash",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first mockup & font organiser for designers (macOS, Apple Silicon)",
  "author": "Neesh",
  "license": "LicenseRef-PolyForm-Shield-1.0.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "pretest:unit": "node scripts/rebuild-better-sqlite3.mjs node",
    "test:e2e": "playwright test",
    "pretest:e2e": "node scripts/rebuild-better-sqlite3.mjs electron",
    "predev": "node scripts/rebuild-better-sqlite3.mjs electron",
    "prestart": "node scripts/rebuild-better-sqlite3.mjs electron",
    "test:watch": "vitest",
    "pretest:watch": "node scripts/rebuild-better-sqlite3.mjs node",
    "db:studio": "drizzle-kit studio",
    "predb:studio": "node scripts/rebuild-better-sqlite3.mjs node"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "electron": "^42.4.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
