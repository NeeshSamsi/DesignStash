{
  "name": "designstash",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first mockup & font organiser for designers (macOS, Apple Silicon)",
  "author": "Neesh",
  "license": "LicenseRef-PolyForm-Shield-1.0.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "prebuild": "node scripts/build-helper.mjs --stage --optional",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "pretest:unit": "node scripts/rebuild-better-sqlite3.mjs node",
    "package:stage": "node scripts/fetch-llama-server.mjs && node scripts/stage-llama-server.mjs && node scripts/build-helper.mjs --stage",
    "package:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --config.mac.identity=-",
    "postpackage:mac": "node scripts/rebuild-better-sqlite3.mjs node",
    "package:mac:signed": "electron-builder --mac -c.mac.notarize=true",
    "package": "pnpm package:stage && pnpm build && pnpm package:mac",
    "helper:build": "node scripts/build-helper.mjs",
    "helper:try": "tsx --tsconfig tsconfig.node.json scripts/helper-try.ts",
    "test:e2e": "playwright test",
    "pretest:e2e": "electron-vite build && node scripts/rebuild-better-sqlite3.mjs electron",
    "predev": "node scripts/rebuild-better-sqlite3.mjs electron",
    "prestart": "node scripts/rebuild-better-sqlite3.mjs electron",
    "test:watch": "vitest",
    "pretest:watch": "node scripts/rebuild-better-sqlite3.mjs node",
    "db:studio": "drizzle-kit studio",
    "predb:studio": "node scripts/rebuild-better-sqlite3.mjs node",
    "dev:ingest": "tsx --tsconfig tsconfig.node.json scripts/dev-ingest.ts",
    "seed:dev": "tsx --tsconfig tsconfig.node.json scripts/seed-dev/seed.ts",
    "predev:ingest": "node scripts/rebuild-better-sqlite3.mjs node",
    "dev:reset": "node scripts/dev-reset.mjs",
    "ai-eval:covers": "tsx --tsconfig tsconfig.node.json scripts/ai-eval/covers.ts",
    "ai-eval:run": "tsx --tsconfig tsconfig.node.json scripts/ai-eval/run.ts",
    "ai-eval:score": "tsx --tsconfig tsconfig.node.json scripts/ai-eval/score.ts",
    "ai-eval:edit-carry": "tsx --tsconfig tsconfig.node.json scripts/ai-eval/edit-carry.ts",
    "ai-eval:edit-carry-score": "tsx --tsconfig tsconfig.node.json scripts/ai-eval/edit-carry-score.ts",
    "ai-eval:pile-score": "tsx --tsconfig tsconfig.node.json scripts/ai-eval/pile-score.ts",
    "ai-eval:slots": "tsx --tsconfig tsconfig.node.json scripts/ai-eval/slots.ts",
    "ai-eval:table": "tsx --tsconfig tsconfig.node.json scripts/ai-eval/table.ts",
    "ds:tokens": "node scripts/ds/build-tokens.mjs",
    "ds:scaffold": "node scripts/ds/scaffold-components.mjs",
    "ds:check": "node scripts/ds/scaffold-components.mjs --check",
    "ds": "pnpm ds:tokens && pnpm ds:scaffold"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/funnel-sans": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.1",
    "@hugeicons/react": "^1.1.9",
    "ag-psd": "^30.1.1",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "posthog-node": "^5.38.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.9",
    "drizzle-kit": "^0.31.10",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "yazl": "^3.3.1"
  }
}
